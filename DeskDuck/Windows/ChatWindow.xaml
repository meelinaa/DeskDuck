<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DeskDuck.ChatWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DeskDuck"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Chat mit DeskDuck AI">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <!-- Title Bar Info / Header -->
            <RowDefinition Height="Auto"/>
            <!-- Message List -->
            <RowDefinition Height="*"/>
            <!-- Typing Indicator -->
            <RowDefinition Height="Auto"/>
            <!-- Input Area -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" BorderBrush="#22888888" BorderThickness="0,0,0,1" Padding="16,12">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Ellipse Width="36" Height="36" Fill="#0078D4">
                        <!-- Icon or placeholder representing the Duck -->
                    </Ellipse>
                    <StackPanel>
                        <TextBlock Text="DeskDuck AI" FontWeight="Bold" FontSize="14" Foreground="{ThemeResource TextControlForeground}"/>
                        <TextBlock Text="Online" FontSize="11" Foreground="Green"/>
                    </StackPanel>
                </StackPanel>
                <ComboBox Grid.Column="1"
                          Width="180"
                          ItemsSource="{x:Bind ChatViewModel.Models, Mode=OneWay}"
                          SelectedItem="{x:Bind ChatViewModel.SelectedModel, Mode=TwoWay}"
                          VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Message History -->
        <ListView x:Name="MessagesList" 
                  Grid.Row="1"
                  ItemsSource="{x:Bind ChatViewModel.Messages}"
                  SelectionMode="None"
                  Padding="0,12"
                  ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="MinHeight" Value="0"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid HorizontalAlignment="{Binding Alignment}" Margin="{Binding BubbleMargin}">
                        <Border Background="{Binding BackgroundBrush}" 
                                CornerRadius="12" 
                                Padding="12,8">
                            <TextBlock Text="{Binding Text}" 
                                       Foreground="{Binding ForegroundBrush}" 
                                       TextWrapping="Wrap" 
                                       FontSize="13"/>
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Typing Indicator -->
        <Border Grid.Row="2" Visibility="{x:Bind ChatViewModel.TypingIndicatorVisibility, Mode=OneWay}" Padding="16,4,16,8">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <ProgressRing IsActive="True" Width="16" Height="16"/>
                <TextBlock Text="DeskDuck überlegt..." FontSize="12" FontStyle="Italic" Foreground="Gray"/>
            </StackPanel>
        </Border>

        <!-- Input Area -->
        <Border Grid.Row="3" BorderBrush="#22888888" BorderThickness="0,1,0,0" Padding="12" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <Grid ColumnDefinitions="*,Auto">
                <TextBox x:Name="InputTextBox"
                         Grid.Column="0"
                         PlaceholderText="Schreibe eine Nachricht..."
                         Text="{x:Bind ChatViewModel.InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         KeyDown="InputTextBox_KeyDown"
                         AcceptsReturn="False"
                         VerticalAlignment="Center"
                         Margin="0,0,8,0"/>
                <Button Grid.Column="1"
                        Content="Senden"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="SendButton_Click"
                        VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
