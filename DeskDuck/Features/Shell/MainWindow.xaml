<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DeskDuck.Features.Shell.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DeskDuck.Features.Shell"
    xmlns:converters="using:DeskDuck.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="DeskDuck">

    <Grid Background="Transparent">

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

            <!-- Notification speech bubble displayed above the duck -->
            <Border x:Name="SpeechBubbleBorder"
                    Background="White"
                    CornerRadius="8"
                    Padding="8,6"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,-40,0,0"
                    MinWidth="80"
                    MaxWidth="200"
                    BorderBrush="Gray"
                    BorderThickness="1"
                    Visibility="{x:Bind BoolToVis(MainViewModel.IsNotificationVisible), Mode=OneWay}">
                <StackPanel Spacing="2">
                    <!--
                        Title block: visible only when NotificationTitle is non-empty.
                        Foreground color is set from code-behind when NotificationColorHex changes,
                        because WinUI has no built-in string-to-Brush converter.
                    -->
                    <TextBlock x:Name="SpeechBubbleTitle"
                               Text="{x:Bind MainViewModel.NotificationTitle, Mode=OneWay}"
                               Visibility="{x:Bind BoolToVis(MainViewModel.IsTitleVisible), Mode=OneWay}"
                               FontSize="12"
                               FontWeight="Bold"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="SpeechBubbleMessage"
                               Text="{x:Bind MainViewModel.NotificationMessage, Mode=OneWay}"
                               FontSize="12"
                               Foreground="Black"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Image
                x:Name="DuckImage"
                Height="50"
                Width="50"
                Stretch="Uniform"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Source="{x:Bind MainViewModel.DuckImageUri, Mode=OneWay}"
                local:DragBehavior.IsDraggable="True">
                <FlyoutBase.AttachedFlyout>
                    <MenuFlyout x:Name="DuckContextMenu">
                        <MenuFlyoutItem Text="Chat mit KI" Command="{x:Bind MainViewModel.OpenChatCommand}" />
                        <MenuFlyoutItem Text="Einstellungen" Command="{x:Bind MainViewModel.OpenSettingsCommand}" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Beenden" Command="{x:Bind MainViewModel.ExitCommand}" />
                    </MenuFlyout>
                </FlyoutBase.AttachedFlyout>
            </Image>

            <!-- Coordinate overlay displayed beneath the duck -->
            <TextBlock
                Text="{x:Bind MainViewModel.CoordinatesText, Mode=OneWay}"
                Visibility="{x:Bind BoolToVis(MainViewModel.AreCoordinatesVisible), Mode=OneWay}"
                FontSize="10"
                Foreground="Black"
                HorizontalAlignment="Center"
                Margin="0,4,0,0"/>
        </StackPanel>
    </Grid>
</Window>
